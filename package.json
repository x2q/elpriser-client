{
  "name": "elpriser-client",
  "version": "1.0.0",
  "description": "Tiny, zero-dependency, typed JS/TS client for the elpriser.org API — Danish electricity prices (DK1/DK2): current price, cheapest hours, 7-day forecast.",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "elpriser",
    "electricity-prices",
    "spotpris",
    "denmark",
    "dk1",
    "dk2",
    "energidataservice",
    "nordpool",
    "api-client",
    "energy"
  ],
  "homepage": "https://elpriser.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x2q/elpriser-client.git"
  },
  "bugs": {
    "url": "https://github.com/x2q/elpriser-client/issues"
  },
  "author": "elpriser.org",
  "license": "MIT"
}
